# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local application configuration
APP_URL=http://localhost:3000
SUPABASE_PROJECT_REF=your-project-ref

# Server-only secrets belong in .env.local or the hosting dashboard.
SUPABASE_SECRET_KEY=

# Optional pilot bootstrap values
BOOTSTRAP_OWNER_EMAILS=owner@example.com
BOOTSTRAP_STAFF_EMAILS=staff@example.com
DEFAULT_ORGANIZATION_NAME=RepairLog Test Cafe
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCATION_NAME=Main Cafe

# Lemon Squeezy billing (server-only). Use separate test and live values.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_URL=https://your-domain/api/webhooks/lemonsqueezy
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_YEARLY=
LEMONSQUEEZY_TEST_MODE=true

# Protects /api/jobs/billing, called by the Netlify scheduled function.
CRON_SECRET=

# Salts the hashed network address used to rate-limit public QR reports.
PUBLIC_REPORT_SECRET=

# Cloudflare Turnstile bot protection for the public QR form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shown on the privacy, terms and support pages.
SUPPORT_EMAIL=
LEGAL_ENTITY_NAME=
LEGAL_COUNTRY=

# Email (Resend). EMAIL_FROM must use a domain verified in Resend,
# e.g. "RepairLog <hello@your-domain>". Until then the test sender is used.
RESEND_API_KEY=
EMAIL_FROM=
