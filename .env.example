# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local application configuration
APP_URL=http://localhost:3000
SUPABASE_PROJECT_REF=your-project-ref

# Server-only secrets belong in .env.local or the hosting dashboard.
SUPABASE_SECRET_KEY=

# Optional pilot bootstrap values
BOOTSTRAP_OWNER_EMAILS=owner@example.com
BOOTSTRAP_STAFF_EMAILS=staff@example.com
DEFAULT_ORGANIZATION_NAME=RepairLog Test Cafe
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LOCATION_NAME=Main Cafe
